# Supabase Configuration
# Replace these placeholder values with your project credentials from the Supabase dashboard (Project Settings > API)

# Public URL of your Supabase instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public / Anon API Key (used for client-side queries)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Secret / Service Role Key (SERVER-ONLY: never expose in client code or public repositories)
SUPABASE_SECRET_KEY=your-secret-key-here
